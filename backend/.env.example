# ===========================================
# NFC Anycubic Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=localhost
DB_DATABASE=nfcscan
DB_USERNAME=nfcuser
DB_PASSWORD=your_secure_database_password

# ===========================================
# Application Settings
# ===========================================
APP_ENV=production
APP_DEBUG=false
APP_BASE_URL=https://api.engageengine.ch

# ===========================================
# JWT Configuration
# ===========================================
# Generate with: openssl rand -hex 64
JWT_SECRET=generate_a_secure_random_64_byte_hex_string

# ===========================================
# Apple OAuth / Sign In with Apple
# ===========================================
APPLE_CLIENT_ID=com.engageengine.nfcfilament.service
APPLE_TEAM_ID=Z9M8YMPUDS
APPLE_KEY_ID=Z9M8YMPUDS
APPLE_BUNDLE_ID=com.engageengine.nfcfilament

# ===========================================
# Apple App Store Server API (StoreKit 2)
# ===========================================
# Get from App Store Connect > Keys > In-App Purchase
APPLE_ISSUER_ID=your_app_store_connect_issuer_id
APPLE_KEY_ID_APPSTORE=your_app_store_connect_key_id

# ===========================================
# Google OAuth
# ===========================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Comma-separated list of accepted client IDs (iOS, Android, Web)
GOOGLE_ACCEPTED_CLIENT_IDS=client_id_1,client_id_2

# ===========================================
# CORS Configuration
# ===========================================
# Comma-separated list of allowed origins (use * for development only)
CORS_ALLOWED_ORIGINS=https://app.engageengine.ch

# ===========================================
# CRON Security
# ===========================================
# Generate with: openssl rand -hex 32
CRON_SECRET=generate_a_secure_random_32_byte_hex_string

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_PER_MINUTES=1
