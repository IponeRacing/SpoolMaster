{
    "name": "nfcanycubic/backend-api",
    "description": "NFC Anycubic Backend API - OAuth Apple & Google",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "ext-pdo": "*",
        "ext-json": "*",
        "firebase/php-jwt": "^6.10"
    },
    "autoload": {
        "psr-4": {
            "NfcAnycubic\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
