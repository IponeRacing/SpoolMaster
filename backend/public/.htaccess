# Apache configuration for NFC Anycubic API
# Redirige toutes les requêtes vers index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Rediriger vers HTTPS : seulement GET/HEAD (un POST redirigé devient un
    # GET et casserait un webhook) et hors /cron/ (planificateur Infomaniak,
    # protocole inconnu). X-Forwarded-Proto : pas de boucle derrière un proxy.
    # THE_REQUEST (ligne de requête d'origine), pas REQUEST_URI : après la
    # réécriture vers index.php, les règles sont relues avec /index.php.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{THE_REQUEST} !^[A-Z]+\s/cron/
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect all requests to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# CORS : géré par index.php (liste blanche CORS_ALLOWED_ORIGINS). Un en-tête
# fixé ici écrasait la liste blanche par « * » (retiré le 06.10.2026).
# HSTS et X-Content-Type-Options : déjà envoyés par l'hébergement.

# Disable directory listing
Options -Indexes

# Prevent access to sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
