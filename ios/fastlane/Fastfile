import File.expand_path("~/.fastlane/SharedFastfile")

default_platform(:ios)

platform :ios do

  desc "Génère les fichiers metadata depuis applestorelang.csv"
  lane :generate_metadata do
    require_relative 'csv_to_metadata'

    csv_path = File.expand_path('../../applestorelang.csv', __dir__)
    metadata_dir = File.expand_path('metadata', __dir__)

    UI.message("🔄 Génération des métadonnées depuis le CSV...")
    count = generate_metadata(csv_path, metadata_dir)
    UI.success("✅ #{count} langues générées dans fastlane/metadata/")
  end

  desc "Envoie les métadonnées vers App Store Connect (sans binaire ni screenshots)"
  desc "Option: version:X.Y.Z pour créer/cibler une version éditable sur ASC"
  lane :upload_metadata do |options|
    # Note: ne régénère plus depuis le CSV automatiquement.
    # Lancer 'fastlane ios generate_metadata' manuellement si le CSV a été mis à jour.

    deliver(
      api_key: shared_api_key,
      app_identifier: "com.engageengine.nfcfilament",
      app_version: options[:version],
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submission_information: nil,
      ignore_language_directory_validation: true,
    )
  end

  desc "Upload IPA vers App Store Connect (TestFlight)"
  lane :upload_app do
    ipa_path = File.expand_path('../../build/ios/ipa/Spool Master.ipa', __dir__)

    unless File.exist?(ipa_path)
      UI.user_error!("IPA non trouvée: #{ipa_path}\nLance: flutter build ios --release + xcodebuild -exportArchive")
    end

    pilot(
      api_key: shared_api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
    )

    # Upload dSYMs to Firebase Crashlytics (l'action exige un .zip, pas un dossier)
    dsym_dir = File.expand_path('../../build/ios/archive/Runner.xcarchive/dSYMs', __dir__)
    if File.directory?(dsym_dir)
      dsym_zip = File.expand_path('../../build/ios/dSYMs.zip', __dir__)
      File.delete(dsym_zip) if File.exist?(dsym_zip)
      sh("cd #{File.dirname(dsym_dir).shellescape} && zip -rq #{dsym_zip.shellescape} dSYMs")
      upload_symbols_to_crashlytics(
        dsym_path: dsym_zip,
        gsp_path: File.expand_path('../Runner/GoogleService-Info.plist', __dir__),
      )
      UI.success("✅ dSYMs uploadés vers Firebase Crashlytics")
    else
      UI.important("⚠️ dSYMs non trouvés: #{dsym_dir}")
    end
  end

  desc "Upload metadata + IPA"
  lane :deploy do
    upload_metadata
    upload_app
  end

  desc "Soumet la version à la review App Store (build déjà uploadé ET traité par Apple)"
  desc "Usage: fastlane ios submit_review version:1.3.3 build:71"
  lane :submit_review do |options|
    deliver(
      api_key: shared_api_key,
      app_identifier: "com.engageengine.nfcfilament",
      app_version: options[:version],
      build_number: options[:build],
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      force: true,
      ignore_language_directory_validation: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      submit_for_review: true,
      automatic_release: true,
      # Déclarations IDFA (AdMob) + chiffrement exempt (HTTPS uniquement)
      submission_information: {
        add_id_info_uses_idfa: true,
        add_id_info_serves_ads: true,
        add_id_info_tracks_action: true,
        add_id_info_tracks_install: true,
        add_id_info_limits_tracking: true,
        export_compliance_uses_encryption: false,
      }
    )
  end

end

platform :android do

  ANDROID_METADATA_DIR = File.expand_path('metadata/android', __dir__)

  # Mapping iOS locale → Google Play locale
  LOCALE_MAP = {
    'en-US' => 'en-US', 'en-AU' => 'en-AU', 'en-CA' => 'en-CA', 'en-GB' => 'en-GB',
    'fr-FR' => 'fr-FR', 'fr-CA' => 'fr-CA', 'de-DE' => 'de-DE',
    'es-ES' => 'es-ES', 'es-MX' => 'es-419', 'it' => 'it-IT',
    'pt-BR' => 'pt-BR', 'pt-PT' => 'pt-PT', 'nl-NL' => 'nl-NL',
    'da' => 'da-DK', 'no' => 'no-NO', 'sv' => 'sv-SE', 'fi' => 'fi-FI',
    'pl' => 'pl-PL', 'cs' => 'cs-CZ', 'sk' => 'sk', 'hu' => 'hu-HU',
    'ro' => 'ro', 'ca' => 'ca', 'ru' => 'ru-RU', 'uk' => 'uk',
    'bg' => 'bg', 'hr' => 'hr', 'sl' => 'sl', 'sr' => 'sr',
    'el' => 'el-GR', 'tr' => 'tr-TR', 'ar-SA' => 'ar',
    'he' => 'iw-IL', 'hi' => 'hi-IN', 'ja' => 'ja-JP', 'ko' => 'ko-KR',
    'ms' => 'ms', 'id' => 'id', 'th' => 'th', 'vi' => 'vi',
    'zh-Hans' => 'zh-CN', 'zh-Hant' => 'zh-TW',
  }

  desc "Génère les metadata Android depuis les metadata iOS"
  lane :generate_metadata do
    ios_metadata_dir = File.expand_path('metadata', __dir__)

    LOCALE_MAP.each do |ios_locale, android_locale|
      ios_dir = File.join(ios_metadata_dir, ios_locale)
      next unless File.directory?(ios_dir)

      android_dir = File.join(ANDROID_METADATA_DIR, android_locale)
      FileUtils.mkdir_p(File.join(android_dir, 'changelogs'))

      # title.txt ← name.txt
      src = File.join(ios_dir, 'name.txt')
      FileUtils.cp(src, File.join(android_dir, 'title.txt')) if File.exist?(src)

      # short_description.txt ← subtitle.txt (80 chars max pour Google Play)
      src = File.join(ios_dir, 'subtitle.txt')
      if File.exist?(src)
        subtitle = File.read(src).strip
        File.write(File.join(android_dir, 'short_description.txt'), subtitle)
      end

      # full_description.txt ← description.txt, UNIQUEMENT si le fichier Android
      # n'existe pas encore. Les descriptions divergent volontairement : sur
      # iOS, Bambu Lab / Creality (MiFare Classic) ne sont pas lisibles
      # (CoreNFC) → la description iOS ne promet que la saisie manuelle,
      # alors que l'Android lit et écrit ces tags. Écraser l'Android avec
      # l'iOS lui ferait perdre ces fonctionnalités réelles.
      src = File.join(ios_dir, 'description.txt')
      android_desc = File.join(android_dir, 'full_description.txt')
      if File.exist?(src) && !File.exist?(android_desc)
        desc = File.read(src)
        desc.gsub!(/\s*[\(（]Android[\)）]/, '')  # Supprimer markers (Android) et （Android）
        desc.gsub!(/https:\/\/www\.apple\.com\/.*$/, '')  # Supprimer lien EULA Apple
        desc.strip!
        File.write(File.join(android_dir, 'full_description.txt'), desc)
      end

      # changelogs/default.txt ← release_notes.txt (sans markers "(Android)" et refs iOS)
      src = File.join(ios_dir, 'release_notes.txt')
      if File.exist?(src)
        notes = File.read(src)
        notes.gsub!(/\s*[\(（]Android[\)）]/, '')  # Supprimer markers (Android) et （Android）
        notes.gsub!(/^-.*(?:Android.*iOS|iOS.*Android).*\n?/, '')  # Supprimer lignes mentionnant Android+iOS
        notes.strip!
        # Google Play limite les changelogs à 500 caractères (iOS: 4000).
        # Tronquer proprement sur une frontière de phrase/mot si dépassement.
        if notes.length > 500
          cut = notes[0, 500]
          # revenir au dernier point/espace pour ne pas couper un mot
          boundary = cut.rindex(/[.!?]\s/) || cut.rindex(' ')
          notes = boundary ? cut[0, boundary + 1].strip : cut.strip
        end
        File.write(File.join(android_dir, 'changelogs', 'default.txt'), notes)
      end
    end

    # es-US = copie de es-419 (Google Play les distingue, pas Apple)
    es419_dir = File.join(ANDROID_METADATA_DIR, 'es-419')
    if File.directory?(es419_dir)
      esus_dir = File.join(ANDROID_METADATA_DIR, 'es-US')
      FileUtils.mkdir_p(File.join(esus_dir, 'changelogs'))
      %w[title.txt short_description.txt full_description.txt].each do |f|
        src = File.join(es419_dir, f)
        FileUtils.cp(src, File.join(esus_dir, f)) if File.exist?(src)
      end
      src = File.join(es419_dir, 'changelogs', 'default.txt')
      FileUtils.cp(src, File.join(esus_dir, 'changelogs', 'default.txt')) if File.exist?(src)
    end

    total = LOCALE_MAP.count + 1  # +1 pour es-US
    UI.success("✅ #{total} locales Android générées dans metadata/android/")
  end

  desc "Envoie les métadonnées vers Google Play (sans binaire ni screenshots)"
  lane :upload_metadata do
    generate_metadata

    upload_to_play_store(
      json_key: SHARED_GOOGLE_JSON_KEY,
      package_name: 'com.engagengine.nfc_anycubic',
      metadata_path: ANDROID_METADATA_DIR,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,  # changelogs nécessitent un version_code (upload avec AAB)
    )
  end

  desc "Upload AAB vers Google Play (internal track)"
  lane :upload_app do
    aab_path = File.expand_path('../../build/app/outputs/bundle/release/app-release.aab', __dir__)

    unless File.exist?(aab_path)
      UI.user_error!("AAB non trouvée: #{aab_path}\nLance: flutter build appbundle --release")
    end

    # Regénérer les changelogs avant upload pour être sûr qu'ils sont à jour
    generate_metadata

    upload_to_play_store(
      json_key: SHARED_GOOGLE_JSON_KEY,
      package_name: 'com.engagengine.nfc_anycubic',
      aab: aab_path,
      track: 'internal',
      metadata_path: ANDROID_METADATA_DIR,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Upload metadata + AAB"
  lane :deploy do
    upload_metadata
    upload_app
  end

  desc "Promeut la release internal vers production (déclenche la review Google)"
  lane :promote_to_production do
    upload_to_play_store(
      json_key: SHARED_GOOGLE_JSON_KEY,
      package_name: 'com.engagengine.nfc_anycubic',
      track: 'internal',
      track_promote_to: 'production',
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
    )
  end

end
